{
  "schema_version": "4",
  "command": "status",
  "status": "findings",
  "data": {
    "profile": "default",
    "entries": [
      {
        "source": "configs/zsh/zshrc",
        "target": "/home/user/.zshrc",
        "strategy": "symlink",
        "state": "ok"
      },
      {
        "source": "configs/git/config",
        "target": "/home/user/.gitconfig",
        "strategy": "copy",
        "state": "missing"
      }
    ],
    "provisioners": {
      "profile": "default",
      "steps": [
        {
          "tool": "skills",
          "executable": "npx",
          "args": [
            "--yes",
            "skills@1.5.12",
            "add",
            "vercel-labs/agent-skills"
          ],
          "targets": [
            "~/.agents/skills"
          ]
        }
      ]
    }
  }
}
