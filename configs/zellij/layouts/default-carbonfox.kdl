// Carbonfox colors adapted from Nightfox revision
// 4dacd3f0185a2227bdf3b6c0975a8f0bf87cac9a (../../themes/LICENSE-nightfox).
layout {
    default_tab_template {
        pane size=1 borderless=true {
            // Tmux-like Carbonfox status bar. The zjstatus plugin binary is a
            // manual per-machine prerequisite and is not vendored by this
            // repository. Keeping the status pane before `children` places it
            // at the top, matching configs/tmux/tmux.conf.
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode} #[fg=#78A9FF,bold]{session}"
                format_center "{tabs}"
                format_right  "{command_git_branch} {datetime}"
                format_space  ""

                border_enabled "false"
                hide_frame_for_single_pane "true"

                mode_normal "#[bg=#78A9FF,fg=#0C0C0C,bold] NORMAL "
                mode_tmux   "#[bg=#3DDBD9,fg=#0C0C0C,bold] TMUX "
                mode_locked "#[bg=#EE5396,fg=#0C0C0C,bold] LOCKED "
                mode_resize "#[bg=#08BDBA,fg=#0C0C0C,bold] RESIZE "
                mode_tab    "#[bg=#25BE6A,fg=#0C0C0C,bold] TAB "
                mode_scroll "#[bg=#BE95FF,fg=#0C0C0C,bold] SCROLL "

                tab_normal            "#[fg=#6E6F70] {name} "
                tab_active            "#[fg=#25BE6A,bold,italic] {name} "
                tab_active_fullscreen "#[fg=#25BE6A,bold,italic] {name} [F]"
                tab_separator         ""

                datetime          "#[fg=#7B7C7E] {format} "
                datetime_format   "%H:%M"
                datetime_timezone "America/Bogota"

                command_git_branch_command  "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format   "#[fg=#FF7EB6] {stdout} "
                command_git_branch_interval "10"
            }
        }
        children
    }
}
